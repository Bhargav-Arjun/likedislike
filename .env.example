# Copy this file to .env.local and fill in your own values

# Supabase -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# TMDB (free) -> themoviedb.org/settings/api -> API Read Access Token / API Key
# Used server-side only (app/api/fetch-movie) so it never reaches the browser
TMDB_API_KEY=your_tmdb_api_key_here

# No key needed for songs -- iTunes Search API is used and is free/open
